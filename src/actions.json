    {
        "key": "apache_restart",
        "name": "Restart Apache",
        "interactive": false,
        "commands": [
            "sudo systemctl restart apache2",
            "sudo apache2ctl configtest",
            "sleep 5"
        ]
    },
    {
        "key": "agora_setup_project_extranet",
        "name": "Setup for extranet project",
        "interactive": false,
        "commands": [
            "(npm install -g n && n 22)",
            "(sudo a2dissite *.conf || echo 'No site to disable')",
            "sudo a2ensite dev-extranet.conf",
            "sudo systemctl restart apache2"
        ]
    },
